// ============================================================================
// ANALOG BUS COMPRESSOR
// Master bus dynamics processor with analog-style character
// Soft-knee detection, transformer saturation, sidechain HPF
// ============================================================================

// CC30: Threshold  CC31: Ratio  CC32: Attack  CC33: Release
// CC34: Makeup Gain  CC35: Mix  CC36: SC HPF  CC37: Saturation

fun softclip(x:real) : real {
  val ax = abs(x);
  val sign = if x >= 0.0 then 1.0 else -1.0;
  val out = if ax > 1.0 then 1.0 - 1.0 / (1.0 + (ax - 1.0) * 2.0) else ax;
  return out * sign;
}

fun process(input:real) : real {
  mem threshold_cc;
  mem ratio_cc;
  mem attack_cc;
  mem release_cc;
  mem makeup_cc;
  mem mix_cc;
  mem hpf_cc;
  mem sat_cc;

  mem env;
  mem gain_smooth;
  mem sc_hp_z1;

  val sr = 44100.0;

  // --- Sidechain HPF (1-pole, removes low-end pumping) ---
  val hpf_freq = hpf_cc * 300.0;
  val hpf_f = if hpf_freq > 5.0 then hpf_freq else 5.0;
  val hpf_coeff = exp(-2.0 * 3.14159265 * hpf_f / sr);
  val sc_filtered = input - sc_hp_z1;
  sc_hp_z1 = sc_hp_z1 + (input - sc_hp_z1) * (1.0 - hpf_coeff);
  val sc_input = if hpf_freq > 5.0 then sc_filtered else input;

  // --- Level detection (RMS envelope) ---
  val sq = sc_input * sc_input;

  // Attack: 0.1ms to 30ms
  val atk_ms = attack_cc * 29.9 + 0.1;
  val atk_coeff = 1.0 - exp(-2.2 / (atk_ms * 0.001 * sr));

  // Release: 50ms to 1200ms
  val rel_ms = release_cc * 1150.0 + 50.0;
  val rel_coeff = 1.0 - exp(-2.2 / (rel_ms * 0.001 * sr));

  // Envelope follower
  val env_k = if sq > env then atk_coeff else rel_coeff;
  env = env + (sq - env) * env_k;
  val rms = sqrt(env + 0.0000001);
  val level_db = 20.0 * log(rms + 0.0000001) / log(10.0);

  // --- Threshold & Ratio ---
  val thresh_db = threshold_cc * 40.0 - 40.0;
  val ratio = ratio_cc * 19.0 + 1.0;

  // --- Soft-knee gain computation (6dB knee) ---
  val knee_db = 6.0;
  val half_knee = knee_db * 0.5;
  val over_db = level_db - thresh_db;

  // Below knee: no compression. Above knee: full ratio. In knee: smooth blend.
  val gr_below = 0.0;
  val gr_above = over_db * (1.0 - 1.0 / ratio);
  val knee_x = over_db + half_knee;
  val gr_knee = knee_x * knee_x / (4.0 * knee_db) * (1.0 - 1.0 / ratio);

  val gain_reduction_db =
    if over_db <= -half_knee then gr_below
    else if over_db >= half_knee then gr_above
    else gr_knee;

  // Target gain in linear
  val target_gain = if gain_reduction_db > 0.001
    then pow(10.0, -gain_reduction_db / 20.0)
    else 1.0;

  // Smooth gain changes
  gain_smooth = gain_smooth + (target_gain - gain_smooth) * 0.005;

  // --- Makeup gain: 0dB to +24dB ---
  val makeup_gain = pow(10.0, makeup_cc * 24.0 / 20.0);

  // Apply compression
  val compressed = input * gain_smooth * makeup_gain;

  // --- Transformer saturation ---
  val sat_amount = sat_cc * 0.6;
  val drive = 1.0 + sat_amount * 2.0;
  val driven = compressed * drive;
  val clipped = softclip(driven);
  val saturated = if sat_amount > 0.01
    then clipped / drive * (1.0 + sat_amount * 0.3)
    else compressed;

  // --- Dry/Wet mix (parallel compression) ---
  val output = input * (1.0 - mix_cc) + saturated * mix_cc;

  return output;
}

and noteOn(note:int, velocity:int, channel:int) { }
and noteOff(note:int, channel:int) { }

and controlChange(control:int, value:int, channel:int) {
  if (control == 30) threshold_cc = real(value) / 127.0; // Threshold
  if (control == 31) ratio_cc     = real(value) / 127.0; // Ratio
  if (control == 32) attack_cc    = real(value) / 127.0; // Attack
  if (control == 33) release_cc   = real(value) / 127.0; // Release
  if (control == 34) makeup_cc    = real(value) / 127.0; // Makeup
  if (control == 35) mix_cc       = real(value) / 127.0; // Mix
  if (control == 36) hpf_cc       = real(value) / 127.0; // SC HPF
  if (control == 37) sat_cc       = real(value) / 127.0; // Saturation
}

and default() {
  threshold_cc = 0.5;
  ratio_cc     = 0.2;
  attack_cc    = 0.3;
  release_cc   = 0.3;
  makeup_cc    = 0.2;
  mix_cc       = 1.0;
  hpf_cc       = 0.1;
  sat_cc       = 0.15;
  env          = 0.0;
  gain_smooth  = 1.0;
  sc_hp_z1     = 0.0;
}
